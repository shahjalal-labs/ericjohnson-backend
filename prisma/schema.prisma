datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String     @id @default(auto()) @map("_id") @db.ObjectId
  email                   String     @unique
  fullName                String
  phoneNumber             String?
  password                String
  role                    UserRole   @default(User)
  status                  UserStatus @default(Active)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  // Additional profile fields
  profileImage            String     @default("https://i.ibb.co.com/nrs3FjM/images.png")
  gender                  Gender     @default(Other)
  visibleGender           Boolean    @default(true)
  appleId                 String?
  fcmToken                String?
  galleryImage1           String?
  galleryImage2           String?
  galleryImage3           String?
  galleryImage4           String?
  galleryImage5           String?
  galleryImage6           String?
  dob                     DateTime?
  visibleDob              Boolean    @default(true)
  profession              String?
  visibleProfession       Boolean    @default(true)
  bio                     String?
  visibleBio              Boolean    @default(true)
  address                 String?
  visibleAddress          Boolean    @default(true)
  religiousBeliefs        String?
  visibleReligiousBeliefs Boolean    @default(true)
  politics                String?
  visiblePolitics         Boolean    @default(true)
  languages               String?
  visibleLanguages        Boolean    @default(true)
  intention               String?
  visibleIntention        Boolean    @default(true)
  height                  Int?
  visibleHeight           Boolean    @default(true)
  myEthnicity             String?
  visibleMyEthnicity      Boolean    @default(true)
  myChildren              String?
  visibleMyChildren       Boolean    @default(true)
  familyPlans             String?
  visibleFamilyPlans      Boolean    @default(true)
  vices                   Json?
  visibleVices            Boolean    @default(true)
  //for matching algorithm
  maxDistance             Int        @default(50)
  interestedIn            Gender     @default(Other)
  minAge                  Int        @default(18)
  maxAge                  Int        @default(100)
  relationship            String?
  ethinicity              String[]
  isEthnicityBreak        Boolean    @default(false)
  religion                String[]
  isReligionBreak         Boolean    @default(false)
  interests               String[]
  //relations
  matchesAsUser1          Match[]    @relation("User1Matches")
  matchesAsUser2          Match[]    @relation("User2Matches")
  sender                  Room[]     @relation("user1Relation")
  receiver                Room[]     @relation("user2Relation")
  friendsAsUser1          Friend[]   @relation("User1Friends")
  friendsAsUser2          Friend[]   @relation("User2Friends")

  @@map("users")
}

model Friend {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String       @db.ObjectId
  user2Id   String       @db.ObjectId
  uniqueKey String       @unique
  status    FriendStatus @default(Pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user1     User         @relation("User1Friends", fields: [user1Id], references: [id])
  user2     User         @relation("User2Friends", fields: [user2Id], references: [id])

  @@index([createdAt])
  @@map("friends")
}

model Match {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String   @db.ObjectId
  user2Id   String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user1     User     @relation("User1Matches", fields: [user1Id], references: [id])
  user2     User     @relation("User2Matches", fields: [user2Id], references: [id])

  @@index([createdAt])
  @@map("matches")
}

model Room {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String?   @db.ObjectId
  user2Id   String?   @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user1     User?     @relation("user1Relation", fields: [user1Id], references: [id])
  user2     User?     @relation("user2Relation", fields: [user2Id], references: [id])
  message   Message[]

  @@unique([user1Id, user2Id])
  @@map("rooms")
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  user1Id   String   @db.ObjectId
  user2Id   String   @db.ObjectId
  content   String?
  fileUrl   String[]
  user1Read Boolean  @default(false)
  user2Read Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      Room     @relation(fields: [roomId], references: [id])

  @@index([createdAt])
  @@map("messages")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("notifications")
}

enum FriendStatus {
  Pending
  Accepted
}

enum UserStatus {
  Active
  Blocked
  Deleted
}

enum UserRole {
  User
  Admin
}

enum Gender {
  Male
  Female
  Other
}
